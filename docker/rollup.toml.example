# Greenfield Docker / compose starter (copy and mount as config.toml).
root = "/data/mail/Newsletters.sbd"
mail_root = "/data/mail"
output_dir = "/data/output"
state_dir = "/data/state"
log_dir = "/data/logs"
lookback_days = 7

# Optional LLM via host Ollama (requires --allow-remote-ollama or Settings):
# ollama = true
# ollama_url = "http://host.docker.internal:11434/api/generate"
